        <mxCell id="ing_pypi" value="&lt;b&gt;PyPI adapter&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="90" y="262" width="230" height="50" as="geometry" />
        </mxCell>
        <mxCell id="ing_npm" value="&lt;b&gt;npm adapter&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="350" y="262" width="230" height="50" as="geometry" />
        </mxCell>
        <mxCell id="ing_crates" value="&lt;b&gt;crates adapter&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="610" y="262" width="230" height="50" as="geometry" />
        </mxCell>
        <mxCell id="ing_go" value="&lt;b&gt;gomod adapter&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="870" y="262" width="240" height="50" as="geometry" />
        </mxCell>

        <!-- ===== QUEUE + DB band ===== -->
        <mxCell id="queue" value="&lt;b&gt;ScanQueue&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;backlog-weighted scheduling&lt;br&gt;(reserved floor + per-eco cap)&lt;br&gt;pending &amp;rarr; claimed &amp;rarr; done/failed&lt;/font&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;size=12;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="340" y="370" width="240" height="110" as="geometry" />
        </mxCell>
        <mxCell id="db" value="&lt;b&gt;PostgreSQL&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;Package, Version, Scan, Finding,&lt;br&gt;FileHash, RuleHit, Watchlist,&lt;br&gt;Detonation, DetonationQueue, TraceEvent&lt;/font&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;size=12;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="700" y="365" width="280" height="120" as="geometry" />
        </mxCell>

        <!-- ===== WORKERS band ===== -->
