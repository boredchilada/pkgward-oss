          <mxGeometry x="870" y="120" width="240" height="55" as="geometry" />
        </mxCell>

        <!-- ===== INGEST band ===== -->
        <mxCell id="ing_band" value="Ingest layer (APScheduler cron + interval triggers) &amp;mdash; gates: focus / watchlist / scope / brand-new" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#d6b656;dashed=1;fontStyle=1;fontSize=12;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;fontColor=#6b5900;" vertex="1" parent="1">
          <mxGeometry x="60" y="220" width="1080" height="110" as="geometry" />
