        </mxCell>
        <mxCell id="lg5" value="detonation (async)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=10;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="1112" y="470" width="150" height="24" as="geometry" />
