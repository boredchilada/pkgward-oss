        <mxCell id="e_s_crates" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#6c8ebf;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="src_crates" target="ing_crates"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e_s_go" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#6c8ebf;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="src_go" target="ing_go"><mxGeometry relative="1" as="geometry" /></mxCell>

        <!-- adapters -> queue -->
        <mxCell id="e_ing_q" value="enqueue (gated)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#d6b656;fontSize=9;exitX=0.25;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="ing_band" target="queue"><mxGeometry relative="1" as="geometry" /></mxCell>

        <!-- queue -> workers -->
        <mxCell id="e_q_w" value="claim (CAS)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#82b366;fontSize=9;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="queue" target="workers"><mxGeometry relative="1" as="geometry" /></mxCell>

        <!-- queue <-> db (visual) -->
        <mxCell id="e_q_db" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#9673a6;dashed=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="queue" target="db"><mxGeometry relative="1" as="geometry" /></mxCell>

        <!-- workers -> pipeline -->
