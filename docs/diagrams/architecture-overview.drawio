        </mxCell>
        <mxCell id="p_extract" value="&lt;b&gt;extract&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;+ hash (sha/entropy/ssdeep/TLSH)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="245" y="678" width="130" height="55" as="geometry" />
        </mxCell>
        <mxCell id="p_diff" value="&lt;b&gt;code-diff&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;changed files only&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="415" y="678" width="120" height="55" as="geometry" />
        </mxCell>
        <mxCell id="p_analyze" value="&lt;b&gt;analyze&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;16 layers (incl. opengrep, YARA, obfuscation)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="575" y="678" width="150" height="55" as="geometry" />
        </mxCell>
        <mxCell id="p_score" value="&lt;b&gt;score&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;suspicious &amp;ge;20 / malicious &amp;ge;61&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="765" y="678" width="130" height="55" as="geometry" />
        </mxCell>
        <mxCell id="p_persist" value="&lt;b&gt;persist&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;Scan + Findings + mark_done&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="935" y="678" width="130" height="55" as="geometry" />
        </mxCell>

        <!-- ===== BOTTOM: triage / dynamic / alerts (below pipeline, downward edges) ===== -->
        <mxCell id="llm" value="&lt;b&gt;OpenRouter (LLM triage)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;deepseek-v4-flash; on static&lt;br&gt;malicious OR suspicious; can escalate/clear&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="90" y="820" width="250" height="80" as="geometry" />
        </mxCell>
        <mxCell id="det_pool" value="&lt;b&gt;Detonation worker pool&lt;/b&gt;  (async)&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;drains DetonationQueue &amp;rarr; detonate &amp;rarr; re-score&lt;br&gt;&amp;rarr; delayed alert on flip to malicious&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;dashed=1;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="380" y="820" width="300" height="80" as="geometry" />
        </mxCell>
        <mxCell id="sandbox" value="&lt;b&gt;Detonation sandbox&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;rootless Docker + Tetragon eBPF (Go)&lt;br&gt;UNIX socket&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="720" y="820" width="250" height="80" as="geometry" />
        </mxCell>
        <mxCell id="discord" value="&lt;b&gt;Discord webhook&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;malicious / needs-review alerts&lt;br&gt;(static + delayed dynamic)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1">
