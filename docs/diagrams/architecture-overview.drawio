        </mxCell>

        <!-- ===== PIPELINE band ===== -->
        <mxCell id="pipe_band" value="Pipeline &amp;mdash; process_one()  (asyncio.to_thread for CPU-bound + DB)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#b85450;dashed=1;fontStyle=1;fontSize=12;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;fontColor=#6b1a17;" vertex="1" parent="1">
          <mxGeometry x="60" y="640" width="1080" height="120" as="geometry" />
