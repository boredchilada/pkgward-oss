<mxfile host="app.diagrams.net" agent="pkgward" version="26.0.0" type="device">
  <diagram id="pkgward-arch" name="Architecture Overview">
    <mxGraphModel dx="1500" dy="1040" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1500" pageHeight="1060" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="title" value="pkgward &amp;mdash; Multi-Ecosystem Architecture" style="text;html=1;fontSize=20;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="450" y="12" width="600" height="34" as="geometry" />
        </mxCell>
        <mxCell id="subtitle" value="Ingest &amp;rarr; Queue &amp;rarr; Workers &amp;rarr; Pipeline (process_one) &amp;rarr; Score &amp;rarr; async Detonation. PyPI &amp;middot; npm &amp;middot; crates.io &amp;middot; Go modules." style="text;html=1;fontSize=11;fontStyle=2;align=center;fontColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="350" y="50" width="800" height="20" as="geometry" />
        </mxCell>

        <!-- ===== SOURCES band ===== -->
        <mxCell id="src_band" value="Package registries (external)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#6c8ebf;dashed=1;fontStyle=1;fontSize=12;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;fontColor=#1a3a6b;" vertex="1" parent="1">
          <mxGeometry x="60" y="80" width="1080" height="110" as="geometry" />
        </mxCell>
        <mxCell id="src_pypi" value="&lt;b&gt;PyPI&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;RSS + XML-RPC cursor&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="90" y="120" width="230" height="55" as="geometry" />
        </mxCell>
        <mxCell id="src_npm" value="&lt;b&gt;npm&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;CouchDB _changes seq&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="350" y="120" width="230" height="55" as="geometry" />
        </mxCell>
        <mxCell id="src_crates" value="&lt;b&gt;crates.io&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;RSS + reconcile&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="610" y="120" width="230" height="55" as="geometry" />
        </mxCell>
