        </mxCell>
        <mxCell id="a_sandbox" value="&lt;b&gt;rootless-Docker sandbox + Tetragon eBPF&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;trace events &amp;rarr; behavioral rules &amp;rarr; dynamic findings&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1045" y="1214" width="270" height="60" as="geometry" />
        </mxCell>
        <mxCell id="a_rescore" value="&lt;b&gt;Persist Detonation + TraceEvents&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;re-score (static + dynamic); update verdict&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1045" y="1304" width="270" height="56" as="geometry" />
        </mxCell>
        <mxCell id="a_alert" value="&lt;b&gt;Flipped to malicious?&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;static verdict was not malicious &amp;rarr;&lt;br&gt;delayed Discord alert (send_dynamic_alert)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fce4ec;strokeColor=#c62828;fontSize=11;" vertex="1" parent="1">
