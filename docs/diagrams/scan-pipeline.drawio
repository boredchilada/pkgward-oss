<mxfile host="app.diagrams.net" agent="pkgward" version="26.0.0" type="device">
  <diagram id="scan-pipeline" name="Scan Pipeline — process_one()">
    <mxGraphModel dx="1400" dy="1800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1380" pageHeight="1860" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="title" value="&lt;b&gt;Scan Pipeline &amp;mdash; process_one()&lt;/b&gt;" style="text;html=1;align=center;verticalAlign=middle;fontSize=20;" vertex="1" parent="1">
          <mxGeometry x="430" y="20" width="420" height="34" as="geometry" />
        </mxCell>
        <mxCell id="subtitle" value="One central flow; CPU-bound + DB work runs via asyncio.to_thread. Detonation is async (right). All 4 ecosystems share this path." style="text;html=1;align=center;fontSize=11;fontStyle=2;fontColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="320" y="58" width="640" height="20" as="geometry" />
        </mxCell>

        <!-- ===== MAIN SPINE ===== -->
        <mxCell id="start" value="" style="ellipse;whiteSpace=wrap;html=1;fillColor=#333333;strokeColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="640" y="86" width="40" height="40" as="geometry" />
        </mxCell>
        <mxCell id="claim" value="&lt;b&gt;Claim queue item&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;validate claim_token (CAS); bind structlog (sid, eco, pkg, w)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="520" y="156" width="280" height="56" as="geometry" />
        </mxCell>
        <mxCell id="fetch" value="&lt;b&gt;Fetch&lt;/b&gt;  (Phase 1 &amp;mdash; async I/O)&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;adapter_registry[eco] (PyPI / npm / crates / gomod)&lt;br&gt;download artifact(s) + verify SHA256 vs registry&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="520" y="246" width="280" height="64" as="geometry" />
        </mxCell>
        <mxCell id="d_fetch" value="&lt;b&gt;Fetch OK?&lt;/b&gt;" style="rhombus;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="585" y="344" width="150" height="70" as="geometry" />
        </mxCell>
        <mxCell id="extract" value="&lt;b&gt;Extract + hash&lt;/b&gt;  (Phase 1.5 &amp;mdash; to_thread)&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;safe_extract (25K-file / size caps; reject symlink/traversal)&lt;br&gt;per-file SHA256 + entropy + ssdeep + TLSH&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="520" y="450" width="280" height="64" as="geometry" />
        </mxCell>
        <mxCell id="d_diff" value="&lt;b&gt;Code changed&lt;br&gt;vs previous?&lt;/b&gt;" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="580" y="554" width="160" height="76" as="geometry" />
        </mxCell>
        <mxCell id="analyze" value="&lt;b&gt;Analyze&lt;/b&gt;  (Phase 2.5 &amp;mdash; to_thread, changed files only)&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;per-eco install/build (setup.py, build.rs, go directives, package.json)&lt;br&gt;+ universal: imports, iocs+decode, opengrep (taint), YARA, obfuscation,&lt;br&gt;binary, secret-access, metadata, version-diff, threat-intel / dep-intel&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="450" y="670" width="420" height="86" as="geometry" />
        </mxCell>
        <mxCell id="score" value="&lt;b&gt;Score + verdict&lt;/b&gt;  (Phase 3)&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;low1 / med8 / high25 / crit60; per-category cap 30&lt;br&gt;suspicious &amp;ge; 20, malicious &amp;ge; 61; behavioral chains + watchlist escalate&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="500" y="800" width="320" height="64" as="geometry" />
        </mxCell>
        <mxCell id="d_llm" value="&lt;b&gt;static malicious&lt;br&gt;OR suspicious?&lt;/b&gt;" style="rhombus;whiteSpace=wrap;html=1;fillColor=#f0e6ff;strokeColor=#7c5cbf;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="575" y="900" width="170" height="76" as="geometry" />
        </mxCell>
        <mxCell id="llm" value="&lt;b&gt;LLM triage&lt;/b&gt;  (Phase 5 &amp;mdash; cost-gated)&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;OpenRouter &amp;rarr; deepseek-v4-flash; spotlighting anti-injection&lt;br&gt;can escalate suspicious&amp;rarr;malicious, clear FP, or return inconclusive&amp;rarr;needs_review&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f0e6ff;strokeColor=#7c5cbf;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="500" y="1016" width="320" height="70" as="geometry" />
        </mxCell>
        <mxCell id="persist" value="&lt;b&gt;Persist&lt;/b&gt;  (Phase 6)&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;upsert Package/Version; write Scan + Findings + FileHash; mark_done&lt;br&gt;bump RuleHit counters (separate txn &amp;mdash; avoids deadlocks)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#cce5ff;strokeColor=#3399ff;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="500" y="1126" width="320" height="64" as="geometry" />
        </mxCell>
        <mxCell id="alert" value="&lt;b&gt;Static alert&lt;/b&gt;  (Phase 7)&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;rule-malicious &amp;rarr; Discord (node-tagged), unless LLM cleared;&lt;br&gt;needs_review &amp;rarr; amber alert&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fce4ec;strokeColor=#c62828;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="500" y="1226" width="320" height="60" as="geometry" />
        </mxCell>
        <mxCell id="enqueue" value="&lt;b&gt;Enqueue DetonationQueue&lt;/b&gt;  (Phase 4)&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;gated (brand-new / watchlist / suspicious+); static verdict recorded&lt;br&gt;scan does NOT block on detonation&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="500" y="1326" width="320" height="64" as="geometry" />
        </mxCell>
        <mxCell id="cleanup" value="&lt;b&gt;finally: cleanup&lt;/b&gt; temp dirs" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="560" y="1430" width="200" height="44" as="geometry" />
        </mxCell>
        <mxCell id="end" value="" style="ellipse;whiteSpace=wrap;html=1;fillColor=#333333;strokeColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="640" y="1514" width="40" height="40" as="geometry" />
        </mxCell>

