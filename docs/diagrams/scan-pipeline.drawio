        <mxCell id="se4" style="edgeStyle=orthogonalEdgeStyle;html=1;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="extract" target="d_diff"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="se5" value="Yes" style="edgeStyle=orthogonalEdgeStyle;html=1;exitX=0.5;exitY=1;entryX=0.5;entryY=0;fontSize=10;" edge="1" parent="1" source="d_diff" target="analyze"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="se6" style="edgeStyle=orthogonalEdgeStyle;html=1;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="analyze" target="score"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="se7" style="edgeStyle=orthogonalEdgeStyle;html=1;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="score" target="d_llm"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="se8" value="Yes" style="edgeStyle=orthogonalEdgeStyle;html=1;exitX=0.5;exitY=1;entryX=0.5;entryY=0;fontSize=10;" edge="1" parent="1" source="d_llm" target="llm"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="se9" style="edgeStyle=orthogonalEdgeStyle;html=1;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="llm" target="persist"><mxGeometry relative="1" as="geometry" /></mxCell>
